<?xml version="1.0"?>
<configuration>
  <system.web>
    <authorization>
      <!-- Administrators: read-only "view as contact" preview (Portal/ViewAs.aspx) -->
      <allow roles="Contact, Administrators, Administrator" />
      <deny users="*" />
    </authorization>
  </system.web>

  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- First-time link from the temporary-password email (email + temporary password + new password) -->
  <location path="ChangePassword.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
