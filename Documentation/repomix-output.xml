                double num1 = Convert.ToDouble(control3.Text);
                string str2 = (string)this.ViewState["GroupByTitle"];
                double num2 = this.ViewState["GroupByTotal"] == null ? 0.0 : (double)this.ViewState["GroupByTotal"];
                double num3;
