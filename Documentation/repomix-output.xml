      }

      public string QBPaymentTermDesc { get { return _QBPaymentTermDesc; } set { _QBPaymentTermDesc = value; } }
      public string QonTPaymentTermDesc { get { return _QonTPaymentTermDesc; } set { _QonTPaymentTermDesc = value; } }
