        public DateTime CalculateNextDeliveryDateRequired(ReoccuringOrderTbl reoccuranceOrder)
        {
            DateTime nextDateRequired = CalculateNextDatesRequired(reoccuranceOrder).DeliveryDate;
            return nextDateRequired;
