            try
            {
                using (var db = new TrackerSQLDb())
                {
                    string sql = @"
                        SELECT AreaPrepDaysID, AreaID, PrepDayOfWeekID, DeliveryDelayDays, DeliveryOrder
                        FROM AreaPrepDaysTbl
