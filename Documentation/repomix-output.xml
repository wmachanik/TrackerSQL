/* DEFAULTS
----------------------------------------------------------*/
:root {
    --primary-brown: #302a20;
    --secondary-brown: #595939;
    --light-brown: #d0d0b9;
    --primary-green: #4e664d;
    --light-green: #e5f0d4;
}

body {
    background: var(--light-green);
    font-size: .80em;
    font-family: "Helvetica Neue", "Lucida Grande", "Segoe UI", sans-serif, Helvetica, Verdana, sans-serif;
    margin: 0;
    padding: 0;
    color: #696969;
}

a:link,
a:visited {
    color: #03b34a;
}
a:hover {
    color: #1dbf60;
    text-decoration: none;
}
a:active {
    color: #03b34a;
}

p {
    margin-bottom: 10px;
    line-height: 1.2em;
}

/* HEADINGS */
h1, h2, h3, h4, h5, h6 {
    color: #607060;
    font-variant: small-caps;
    text-transform: none;
    font-weight: 200;
    margin-bottom: 0;
}
h1 { font-size: 1.6em; padding-bottom: 4px; }
h2 { font-size: 1.5em; font-weight: 600; }
h3 { font-size: 1.2em; }
h4 { font-size: 1.1em; }
h5, h6 { font-size: 1em; }

/* LAYOUT */
.page, .minipage {
    background-color: #fff;
    margin: auto;
}
.page { width: 98%; border: 1px solid transparent; }
.minipage { border: 1px solid #496077; }

.header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 10000;
    width: 100%;
    background: var(--primary-brown);
    border-bottom: 1px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.header td { white-space: nowrap; }
.header td:nth-child(2) { white-space: normal; width: 100%; }
.header h1 {
    font-weight: 700;
    margin: 0;
    padding: 0 0 0 6px;
    color: #f9f9f9;
    border: none;
    font-size: 2em;
    display: inline-block;
}

.miniheader {
    position: relative;
    margin: auto;
    line-height: 2em;
    color: #fff;
    padding: 0 10px 6px 10px;
    background: #473b26;
    border-bottom: 1px solid #fff;
    vertical-align: middle;
}
.miniheader a,
.miniheader a:visited {
    background-color: var(--secondary-brown);
    border: 1px var(--primary-green) solid;
    border-bottom: 1px var(--secondary-brown) solid;
    color: #fff;
    padding: 0 2px;
}
.miniheader a:hover {
    background-color: var(--light-brown);
    color: var(--secondary-brown);
    text-decoration: none;
}

.main, .minimain, .leftCol {
    padding: 0 12px;
    margin: 12px 8px 8px 8px;
}
.main { min-height: 420px; }
.minimain { margin: 6px 12px 8px 4px; }
.leftCol { padding: 6px 0; width: 200px; min-height: 200px; }

.footer {
    color: #4e5766;
    padding: 8px 0 0 0;
    margin: 0 auto;
    text-align: center;
    line-height: normal;
}

/* ======================= */
/* CONSOLIDATED MENU STYLES */
/* ======================= */
.menuBG {
    background-color: var(--primary-brown) !important;
    padding: 4px 0;
    width: 96%;
    margin: 0 auto 5px auto;
    font-family: Calibri, 'Gill Sans', 'Gill Sans MT', 'Trebuchet MS', sans-serif;
    font-size: large;
}
.menu ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
}
.menu ul li {
    position: relative;
    margin: 0 2px;
}
.menu ul li a {
    display: block;
    padding: 8px 12px;
    text-decoration: none !important;
    color: #fff !important;
    border-radius: 4px;
    transition: all 0.3s ease;
    white-space: nowrap;
}
.menu ul li a:hover {
    background-color: var(--light-brown) !important;
    color: var(--secondary-brown) !important;
    transform: translateY(-2px);
}
.StaticSelectedStyle > a,
.DynamicSelectedStyle > a {
    background-color: var(--light-brown) !important;
    color: var(--secondary-brown) !important;
    font-weight: bold !important;
    font-style: italic !important;
    border-bottom: 3px solid var(--primary-green) !important;
}
.menu ul ul {
    display: none;
    position: absolute;
    background-color: var(--primary-brown);
    border: 1px solid var(--primary-green);
    border-radius: 4px;
    padding: 5px 0;
    min-width: 180px;
    z-index: 100;
}
.menu ul li:hover > ul { display: block; }
.menu ul ul li { margin: 3px 0; width: 100%; }
.menu ul ul li a { margin: 0 5px; padding: 6px 10px; }

@media (max-width: 768px) {
    .menu ul { flex-direction: column; align-items: center; }
    .menu ul li { width: 90%; margin: 3px 0; }
    .menu ul ul { position: static; width: 90%; margin-left: 10%; }
    .header table, .header td { display: block; width: 100% !important; text-align: center; padding: 5px 0; }
    .loginDisplay { display: block !important; text-align: center !important; padding: 10px 0 !important; }
}
/* ======================= */
/* END OF MENU STYLES */

/* FORM ELEMENTS */
fieldset {
    margin: 1em 0;
    padding: 1em;
    border: 1px solid #ccc;
}
fieldset p { margin: 2px 12px 10px 10px; }
fieldset.login label,
fieldset.register label,
fieldset.changePassword label { display: block; }
fieldset label.inline { display: inline; }
legend {
    font-size: 1.1em;
    font-weight: 600;
    padding: 2px 4px 8px 4px;
}
input.textEntry,
input.passwordEntry {
    width: 320px;
    border: 1px solid #ccc;
}
div.accountInfo { width: 42%; }

/* MISC */
.title { display: block; float: left; text-align: left; width: 100%; }
.loginDisplay {
    font-size: 1.1em;
    display: inline-block;
    text-align: right;
    padding: 8px;
    color: #fff;
    text-decoration: underline;
    white-space: nowrap;
    vertical-align: top;
    margin-right: 12px;
}
.loginDisplay a:link,
