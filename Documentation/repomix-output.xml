        }
}

/* Small mobile breakpoint - super compact */
@media (max-width: 480px) {
    .TblFlex {
        border-radius: 4px;
        font-size: 0.75em;
    }

        .TblFlex th,
        .TblFlex td {
            padding: 3px 4px;
        }

        .TblFlex th {
            font-size: 0.75em;
            padding: 4px 4px;
        }

        .TblFlex input[type="text"],
        .TblFlex select,
        .TblFlex textarea {
