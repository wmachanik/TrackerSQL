                if (!string.IsNullOrWhiteSpace(quantityText))
                {
                    parts.Add(quantityText);
                }
                if (!string.IsNullOrWhiteSpace(packagingDescription))
                {
                    parts.Add(packagingDescription);
                }

                return string.Join(" ", parts.ToArray());
