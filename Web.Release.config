<?xml version="1.0" encoding="utf-8"?>
<!--
  Release XDT transform applied to Web.config when publishing/packaging with the
  Release configuration (Visual Studio / MSBuild).

  Source of truth for the full production file (manual FTP overwrite): weblive.config.
  Keep transforms here in sync with weblive production deltas.

  Docs: https://go.microsoft.com/fwlink/?LinkId=125889
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <appSettings>
    <add key="Version" value="3.0.1.6"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="ApplicationBaseUrl" value="https://quaffeetracker.co.za/"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="EmailTestMode" value="false"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="EnableRequestTiming" value="false"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="CoffeeCheckupReminderWindowMin" value="4"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DatabaseBackupFolder" value="h:\root\home\webquaffer-001\www\db"
         xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>

  <connectionStrings>
    <!-- Was ApplicationServices — site4now SQL; name required by TrackerSQL -->
    <add name="TrackerDataSQL"
         connectionString="Data Source=SQL8001.site4now.net;Initial Catalog=db_a8d7e2_trackersecurity;User Id=db_a8d7e2_trackersecurity_admin;Password=kxb537b6gc"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <httpRuntime targetFramework="4.8" requestValidationMode="4.5"
                 xdt:Transform="SetAttributes" />
    <!-- Include live legacy role names plus current app names -->
    <authorization xdt:Transform="Replace">
      <allow roles="Administrators, Administrator, Agent Manager, AgentManager, Agents, Repair, repair" />
      <deny users="?" />
    </authorization>
    <pages validateRequest="true" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"
           xdt:Transform="SetAttributes(validateRequest)" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/HttpErrorPage.aspx"
                  xdt:Transform="Replace" />
    <sessionState mode="InProc" timeout="20" xdt:Transform="Insert" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8"
                   xdt:Transform="Insert" />
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" xdt:Transform="SetAttributes" />
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough"
                xdt:Transform="SetAttributes" />
    <rewrite>
      <rules>
        <rule name="HTTP to HTTPS redirect" stopProcessing="true"
              xdt:Transform="InsertBefore(rule[@name='PublicOrderToken'])">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="https://{HTTP_HOST}/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <!-- Dev-only anonymous probe; omit on live (same as weblive.config) -->
  <location path="Test.aspx" xdt:Transform="Remove" xdt:Locator="Match(path)" />

</configuration>
