                                }
                            }

                            if (cmd.result)
                                AppLogger.WriteLog("xmltosql", $"{cmd.type.ToUpper()} command {index + 1} executed successfully");
                            else
                                AppLogger.WriteLog("xmltosql", $"{cmd.type.ToUpper()} command {index + 1} failed: {cmd.errString}");
                        }
                        else
