.status-message {
    margin-top: 8px;
    padding: 10px 16px;
    border-radius: 10px;
    border: 1px solid #d9e2ec;
    background: #f5f7fa;
    color: #2f3b48;
    font-size: 0.9rem;
    line-height: 1.35;
    width: auto;
    max-width: 100%;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    transition: background-color .25s, border-color .25s;
    word-break: break-word;
}
    .status-message:empty {
        display: none;
    }

    .status-message.status-info {
        background: #eef6ff;
        border-color: #c3ddfd;
        color: #1e4976;
    }

    .status-message.status-success {
        background: #ecfdf5;
        border-color: #a7f3d0;
        color: #05603a;
    }

    .status-message.status-warn {
        background: #fffbeb;
        border-color: #fde68a;
        color: #92400e;
    }

    .status-message.status-error {
        background: #fef2f2;
        border-color: #fecaca;
        color: #991b1b;
    }

    .status-message a {
        color: inherit;
        text-decoration: underline;
        font-weight: 500;
    }

    .status-message strong {
        font-weight: 600;
    }
/* ========================= */
/*  CALENDAR FIX             */
/* ========================= */
/* Wrapper */
.calendar-popup {
    z-index: 10000;
    background: #fff;
    border: 1px solid #ccc;
    font-family: Arial, sans-serif;
    font-size: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
}

    /* Container */
    .calendar-popup .ajax__calendar_container {
        background-color: #fff;
        border: none;
    }

    /* Header */
    .calendar-popup .ajax__calendar_header {
        background-color: #f5f5f5;
        text-align: center;
        font-weight: bold;
        padding: 5px;
        position: relative;
    }

    /* Title (month/year) */
    .calendar-popup .ajax__calendar_title {
        cursor: pointer;
    }

    /* Navigation arrows (no image dependency) */
    .calendar-popup .ajax__calendar_prev,
    .calendar-popup .ajax__calendar_next {
        position: absolute;
        top: 5px;
        width: 20px;
        text-align: center;
        cursor: pointer;
        font-weight: bold;
    }

    .calendar-popup .ajax__calendar_prev {
        left: 5px;
    }

    .calendar-popup .ajax__calendar_next {
        right: 5px;
    }

    /* Use characters instead of images */
    .calendar-popup .ajax__calendar_prev:after {
        content: "<";
    }

    .calendar-popup .ajax__calendar_next:after {
        content: ">";
    }

    /* Days grid */
    .calendar-popup .ajax__calendar_body table {
        width: 100%;
        border-collapse: collapse;
    }

    .calendar-popup td {
        text-align: center;
        padding: 4px;
        cursor: pointer;
    }

        /* Hover */
        .calendar-popup td:hover {
            background-color: #e6f2ff;
        }

    /* Selected date */
    .calendar-popup .ajax__calendar_active {
        background-color: #0078d7;
        color: #fff;
    }

    /* Today */
    .calendar-popup .ajax__calendar_today {
        border: 1px solid #0078d7;
    }

    /* Month/year view background fix */
    .calendar-popup .ajax__calendar_months,
    .calendar-popup .ajax__calendar_years {
        background-color: #fff;
    }
``}
