<?xml version="1.0" encoding="utf-8"?>
<!--
  Full production Web.config snapshot for TrackerSQL 3.0.x (quaffeetracker.co.za).

  Use this file to overwrite Web.config on the live host after a manual/FTP deploy.

  Visual Studio Release publish applies the same production deltas via
  Web.Release.config (XDT) onto the local Web.config — keep those transforms
  aligned with this file when live settings change.

  TrackerSQL shape (not legacy TrackerDotNet / Access):
  - Single connection: TrackerDataSQL (site4now; was ApplicationServices)
  - DisableAccessDb=true; no Access/Somee security connection strings
  - DatabaseBackupFolder = host path SQL can write (not web App_Data)
  - HTTPS redirect + PublicOrderToken rewrite
  - EmailTestMode=false; EnableRequestTiming=false
-->
<configuration>
	<appSettings>
		<add key="Version" value="3.0.0.2" />
		<add key="SysEmailFrom" value="orders@quaffee.co.za" />
		<add key="SysCCEmailAddress" value="orders@quaffee.co.za" />
		<add key="EMailLogIn" value="noreply@quaffee.co.za" />
		<add key="EMailPassword" value="Mx7!qkN4!@9zB" />
		<add key="EMailSMTP" value="smtp.office365.com" />
		<add key="EMailPort" value="587" />
		<add key="EMailSSLEnabled" value="true" />
		<add key="GMailSMTP" value="mail.roastery.co.za" />
		<add key="DefaultDeliveryID" value="6" />
		<add key="EmailSocketOption" value="StartTls" />
		<!-- 60s: Office 365 AUTH often exceeds the old live 10s timeout on shared hosting -->
		<add key="EmailTimeout" value="60000" />
		<add key="AppTimeZoneId" value="South Africa Standard Time" />
		<add key="DisableClientSecret" value="FrogQuaffer!IsSad2SayGoodBye.K8mF3nR9" />
		<add key="ApplicationBaseUrl" value="https://quaffeetracker.co.za/" />
		<add key="EmailTestMode" value="false" />
		<add key="EmailTestRecipient" value="warren@machanik.com" />
		<add key="EnableDatabaseDetailedLogging" value="false" />
		<add key="CoffeeCheckupReminderWindowDays" value="9" />
		<!-- Live was tuned to 4 (dev uses 5) -->
		<add key="CoffeeCheckupReminderWindowMin" value="4" />
		<add key="CoffeeCheckupReminderWindowMax" value="30" />
		<add key="CoffeeCheckupMinMonthlyRecurringDays" value="20" />
		<add key="CoffeeCheckupDateMatrixTTLMinutes" value="10" />
		<add key="CoffeeCheckupDateMatrixBufferDays" value="5" />
		<add key="CoffeeCheckupUseSqlMatrix" value="false" />
		<add key="CoffeeCheckupRebuildIfSourceChanges" value="true" />
		<add key="TestNow.Enabled" value="false" />
		<add key="TestNow.Value" value="2025-10-12" />
		<add key="TestNow.InputKind" value="Local" />
		<add key="HolidayClosureImminentDays" value="4" />
		<add key="ContactRepairHistoryMonths" value="48" />
		<add key="RequestChanges.NotifyEmail" value="true" />
		<add key="DisableAccessDb" value="true" />
		<!-- Keep false in production unless diagnosing mail -->
		<add key="EnableEmailLogging" value="false" />
		<add key="EmailDebugSaveMime" value="false" />
		<add key="EnableRequestTiming" value="false" />
		<!-- Absolute path SQL can write to, or ~/App_Data/Backup. Live host often: h:\root\home\...\www\db -->
		<add key="DatabaseBackupFolder" value="h:\root\home\webquaffer-001\www\db" />
	</appSettings>
	<connectionStrings>
		<!-- Was ApplicationServices — same site4now SQL; name required by TrackerSQL -->
		<add name="TrackerDataSQL" connectionString="Data Source=SQL8001.site4now.net;Initial Catalog=db_a8d7e2_trackersecurity;User Id=db_a8d7e2_trackersecurity_admin;Password=kxb537b6gc" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<system.web>
		<compilation debug="false" targetFramework="4.8">
			<assemblies>
				<add assembly="System.Core, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
				<add assembly="System.Web.Extensions.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
				<add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
				<add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
			</assemblies>
		</compilation>
		<httpRuntime targetFramework="4.8" requestValidationMode="4.5" />
		<authentication mode="Forms">
			<forms loginUrl="~/Account/Login.aspx" timeout="2880" />
		</authentication>
		<!-- Include live legacy role names (AgentManager / repair) plus current app names -->
		<authorization>
			<allow roles="Administrators, Administrator, Agent Manager, AgentManager, Agents, Repair, repair" />
			<deny users="?" />
		</authorization>
		<membership>
			<providers>
				<clear />
				<add name="AspNetSqlMembershipProvider" type="System.Web.Security.SqlMembershipProvider" connectionStringName="TrackerDataSQL" enablePasswordRetrieval="false" enablePasswordReset="true" requiresQuestionAndAnswer="false" requiresUniqueEmail="true" maxInvalidPasswordAttempts="5" minRequiredPasswordLength="6" minRequiredNonalphanumericCharacters="1" passwordAttemptWindow="10" applicationName="/" />
			</providers>
		</membership>
		<profile>
			<providers>
				<clear />
				<add name="AspNetSqlProfileProvider" type="System.Web.Profile.SqlProfileProvider" connectionStringName="TrackerDataSQL" applicationName="/" />
			</providers>
		</profile>
		<roleManager enabled="true">
			<providers>
				<clear />
				<add connectionStringName="TrackerDataSQL" applicationName="/" name="AspNetSqlRoleProvider" type="System.Web.Security.SqlRoleProvider" />
				<add applicationName="/" name="AspNetWindowsTokenRoleProvider" type="System.Web.Security.WindowsTokenRoleProvider" />
			</providers>
		</roleManager>
		<pages validateRequest="true" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID">
			<controls>
				<add tagPrefix="ajaxToolkit" assembly="AjaxControlToolkit" namespace="AjaxControlToolkit" />
			</controls>
		</pages>
		<xhtmlConformance mode="Transitional" />
		<customErrors mode="Off" />
		<machineKey decryptionKey="25AEF974B0AA6F8F8D46D5275CE0BAF755D519D6A519A329" validationKey="0E7C4CC08FB899B6520DF0B4AA2D52FEF88F7EC14B1E7415F7EBAC24D63462166BF81A69A7C70B02FA114E788B86C475F03CE21E34941BFDB5FA76F05A3245EF" />
		<sessionState mode="InProc" timeout="20" />
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
	</system.web>

	<location path="Default.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="Account/Login.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>

	<system.webServer>
		<!-- true helps managed handlers / rewrite on shared hosting -->
		<modules runAllManagedModulesForAllRequests="true" />
		<directoryBrowse enabled="true" />
		<defaultDocument>
			<files>
				<clear />
				<add value="Default.aspx" />
			</files>
		</defaultDocument>
		<httpErrors errorMode="Detailed" />
		<urlCompression doDynamicCompression="false" />
		<caching enabled="false" />
		<rewrite>
			<rules>
				<rule name="HTTP to HTTPS redirect" stopProcessing="true">
					<match url="(.*)" />
					<conditions>
						<add input="{HTTPS}" pattern="off" ignoreCase="true" />
					</conditions>
					<action type="Redirect" redirectType="Permanent" url="https://{HTTP_HOST}/{R:1}" />
				</rule>
				<rule name="PublicOrderToken" stopProcessing="true">
					<match url="^o/([A-Za-z0-9_\-~.=]+)$" />
					<action type="Rewrite" url="Pages/ViewMyOrder.aspx?t={R:1}" appendQueryString="false" />
				</rule>
			</rules>
		</rewrite>
	</system.webServer>

	<system.net>
		<mailSettings>
			<smtp from="orders@quaffee.co.za">
				<network host="mail.quaffee.com" userName="orders@quaffee.com" password="Quaff3r*rder" />
			</smtp>
		</mailSettings>
	</system.net>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="AjaxControlToolkit" publicKeyToken="28f01b0e84b6d53e" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-20.1.0.0" newVersion="20.1.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="HtmlAgilityPack" publicKeyToken="bd319b19eaf3b43a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-1.12.1.0" newVersion="1.12.1.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Data.Edm" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.8.5.0" newVersion="5.8.5.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.2.0" newVersion="4.0.2.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.4.0" newVersion="4.0.4.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>

	<location path="Administration/ResetPasswordHelper.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="DisableClient.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
	<location path="Pages/ViewMyOrder.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
		<system.webServer>
			<httpProtocol>
				<customHeaders>
					<add name="Cache-Control" value="no-store, no-cache, must-revalidate" />
					<add name="Pragma" value="no-cache" />
					<add name="Expires" value="0" />
				</customHeaders>
			</httpProtocol>
		</system.webServer>
	</location>
	<!-- Anonymous SQL probe when login cannot reach the DB (remove after go-live if preferred). -->
	<location path="Tools/SqlConnectionTest.aspx">
		<system.web>
			<authorization>
				<allow users="*" />
			</authorization>
		</system.web>
	</location>
</configuration>
