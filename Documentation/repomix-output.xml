                    new TrackerSQL.Classes.DBParameter { ParamName = "@o", DataDbType = System.Data.DbType.Int16, DataValue = (object)prepDay.DeliveryOrder ?? DBNull.Value }
                };
                ExecNonQuery(sql, p);

