    }
}

@media (max-width: 768px) {
    .col-priority-3,
    .col-priority-4,
    .col-priority-5,
    th.col-priority-3,
    th.col-priority-4,
    th.col-priority-5,
    td.col-priority-3,
    td.col-priority-4,
    td.col-priority-5 {
        display: none !important;
    }
}

@media (max-width: 480px) {
    .col-priority-2,
    .col-priority-3,
    .col-priority-4,
    .col-priority-5,
    th.col-priority-2,
    th.col-priority-3,
    th.col-priority-4,
    th.col-priority-5,
    td.col-priority-2,
